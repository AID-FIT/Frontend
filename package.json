    "@react-navigation/native-stack": "7.3.26",
    "axios": "1.12.2",
    "expo": "54.0.13",
    "expo-font": "14.0.9",
    "expo-linear-gradient": "15.0.7",
    "expo-status-bar": "3.0.8",
    "react": "19.1.0",
    "react-native": "0.81.4",
    "react-native-safe-area-context": "5.6.1",
    "react-native-screens": "4.16.0",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  }
