{
  "name": "aid-fit",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "build:web": "expo export --platform web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "ios:iphone15": "xcrun simctl shutdown all || true && xcrun simctl boot \"iPhone 15\" || true && open -a Simulator && expo start --ios",
    "web": "expo start --web",
    "web:local": "expo start --web --localhost --port 8081",
    "web:lan": "expo start --web --lan --port 8081",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@expo/vector-icons": "15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "7.4.7",
    "@react-navigation/native": "7.2.2",
    "@react-navigation/native-stack": "7.3.26",
    "axios": "1.12.2",
    "expo": "54.0.13",
    "expo-auth-session": "~7.0.11",
    "expo-crypto": "~15.0.9",
    "expo-font": "14.0.9",
    "expo-linear-gradient": "15.0.7",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "3.0.8",
    "expo-web-browser": "~15.0.11",
    "jest-expo": "~54.0.17",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.4",
    "react-native-safe-area-context": "5.6.1",
    "react-native-screens": "4.16.0",
    "react-native-web": "^0.21.0",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.10",
    "@types/react-test-renderer": "^19.1.0",
    "jest": "^29.7.0",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ]
  }
}
